# Copy to .env and fill in. Real environment variables override these.

# Repository whose pull requests to analyse. `python main.py owner/repo` overrides it.
TARGET_REPO=your-org/your-repo

# Optional: which PRs to analyse (open, closed or all) and how many of the most recently updated.
PR_STATE=open
PR_LIMIT=20

# Optional: local model. Each conflict group and each isolated PR is one model call.
OLLAMA_MODEL=llama3.2:latest
OLLAMA_URL=http://localhost:11434/api/generate
